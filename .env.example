# ---- jev (labs e API) ----
JEV_BACKEND=openrouter          # openrouter | mock
JEV_MODEL=typesafe/jev-1.13
OPENROUTER_API_KEY=

# ---- LLM da cascata. IDs "-latest" do OpenRouter levam "~" ----
# API v2: default do código é openai/gpt-5.6-luna, versão FIXA (o alias ~openai/gpt-luna-latest pode
# mudar de modelo e de preço sem aviso); só defina pra trocar.
# Lab 05 foi medido com ~openai/gpt-sol-latest — use esse valor pra reproduzir aqueles números.
# LLM_MODEL=openai/gpt-5.6-luna

# ---- API v2 ----
# Token fine-grained, read-only em repos públicos. Sem ele: 60 req/h por IP no GitHub.
GITHUB_TOKEN=

# ---- guardas da API (defaults entre parênteses) ----
# RATE_PER_MIN=6            triagens novas por IP por minuto (acerto de cache não conta)
# RATE_PER_DAY=10           idem, por dia (os exemplos da página são gravados e não contam)
# MAX_LLM_CALLS_DAY=200     teto diário de chamadas ao LLM; estourou → cascata desliga, jev segue
# MAX_SPEND_DAY_USD=2.0     teto diário de gasto total; estourou → 503 até a meia-noite UTC
# Teto duro: o limite de crédito da key no OpenRouter. Acabou → erro credits_exhausted na página.

# API_DOCS=1                 publica /api/docs e /api/openapi.json (só dev; em produção ficam fechados)

# ---- deploy ----
# Porta alocada pro container no inventory do lab (servers/oute-server/PORTS.md).
APP_PORT=3770
