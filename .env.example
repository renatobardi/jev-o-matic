# ---- jev (labs e API) ----
JEV_BACKEND=openrouter          # openrouter | mock
JEV_MODEL=typesafe/jev-1.13
OPENROUTER_API_KEY=

# ---- LLM da cascata (lab 05 e API no M3). IDs "-latest" do OpenRouter levam "~" ----
LLM_MODEL=~openai/gpt-sol-latest

# ---- API v2 ----
# Token fine-grained, read-only em repos públicos. Sem ele: 60 req/h por IP no GitHub.
GITHUB_TOKEN=

# ---- deploy ----
# Porta alocada pro container no inventory do lab (servers/oute-server/PORTS.md).
APP_PORT=3770
